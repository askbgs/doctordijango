# =============================================================================
# WhatsApp AI Sales Agent - Environment Configuration
# =============================================================================
# Copy to .env and fill in your values. Never commit .env to version control.

# --- Meta WhatsApp Cloud API ---
META_WHATSAPP_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# --- AI Provider (Anthropic) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-20250514
AI_MAX_TOKENS=1024
AI_TOOL_CALL_LIMIT=5
AI_TIMEOUT_MS=30000
AI_FALLBACK_RESPONSE=I'm sorry, I'm having trouble right now. Please try again shortly or type "help" to speak with our team.

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- n8n ---
N8N_BASE_URL=http://localhost:5678
N8N_ENCRYPTION_KEY=
N8N_WEBHOOK_URL=

# --- Admin Dashboard (Next.js) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Business Configuration Defaults ---
SHOP_NAME=Fashion House
SHOP_CURRENCY=LKR
SHOP_COUNTRY=LK
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,ta,si

# --- Staff Notifications ---
STAFF_NOTIFICATION_WHATSAPP=
STAFF_NOTIFICATION_EMAIL=
