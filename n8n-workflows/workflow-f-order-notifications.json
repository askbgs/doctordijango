            }
          ],
          "combinator": "and"
        }
      },
      "id": "f-node-25",
      "name": "Not Already Sent?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1400, 620]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/{{ $env.WHATSAPP_API_VERSION }}/{{ $env.META_PHONE_NUMBER_ID }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{ $env.META_WHATSAPP_ACCESS_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $('Build Customer Notification').item.json.whatsapp_id }}\",\n  \"type\": \"text\",\n  \"text\": { \"body\": {{ JSON.stringify($('Build Customer Notification').item.json.message) }} }\n}",
        "options": { "timeout": 15000 }
      },
      "id": "f-node-26",
      "name": "Send Customer WhatsApp Update",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1640, 560]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/audit_logs",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"entity_type\": \"order\",\n  \"entity_id\": \"{{ $('Build Customer Notification').item.json.order_id }}\",\n  \"action\": \"status_notification_{{ $('Build Customer Notification').item.json.status }}\",\n  \"changes\": {\n    \"order_ref\": \"{{ $('Build Customer Notification').item.json.order_ref }}\",\n    \"language\": \"{{ $('Build Customer Notification').item.json.language }}\"\n  }\n}",
        "options": {}
      },
      "id": "f-node-27",
      "name": "Record Notification Sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1880, 560]
    }
  ],
