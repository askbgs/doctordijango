        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"entity_type\": \"workflow_error\",\n  \"entity_id\": \"00000000-0000-0000-0000-000000000000\",\n  \"action\": \"client_error\",\n  \"changes\": {\n    \"workflow\": \"{{ $('Parse & Sanitize Error').item.json.workflow_name }}\",\n    \"node\": \"{{ $('Parse & Sanitize Error').item.json.failed_node }}\",\n    \"error\": \"{{ $('Parse & Sanitize Error').item.json.error_message }}\",\n    \"classification\": \"client\"\n  }\n}",
        "options": {}
      },
      "id": "g-node-12",
      "name": "Log Client Error",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 240]
    },

    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/{{ $env.WHATSAPP_API_VERSION }}/{{ $env.META_PHONE_NUMBER_ID }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{ $env.META_WHATSAPP_ACCESS_TOKEN }}" },
