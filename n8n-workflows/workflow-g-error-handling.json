        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $env.STAFF_NOTIFICATION_WHATSAPP }}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": \"🚨 *CRITICAL — Retries exhausted*\\n\\nWorkflow: {{ $json.workflow_name }}\\nNode: {{ $json.failed_node }}\\nError: {{ $json.error_message }}\\nRetries: {{ $json.retry_count }}/3\\n\\nManual intervention required.\"\n  }\n}",
        "options": { "timeout": 15000 }
      },
      "id": "g-node-30",
      "name": "Alert: Retries Exhausted",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1440, 20]
    }
  ],
