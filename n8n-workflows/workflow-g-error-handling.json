            { "name": "Authorization", "value": "Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"entity_type\": \"health_check\",\n  \"entity_id\": \"00000000-0000-0000-0000-000000000000\",\n  \"action\": \"health_check_failed\",\n  \"changes\": {\n    \"failures\": {{ JSON.stringify($json.failures) }},\n    \"checked_at\": \"{{ $json.checked_at }}\"\n  }\n}",
        "options": {}
      },
      "id": "g-node-26",
