    {
      "parameters": {
        "content": "## Health Check\nRuns every 15 minutes.\nPings Supabase and WhatsApp API to verify connectivity.\nAlerts admin if either service is unreachable.",
        "width": 400,
        "height": 120
      },
      "id": "g-sticky-2",
      "name": "Health Check Section",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [100, 620]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "minutes", "minutesInterval": 15 }
          ]
        }
      },
      "id": "g-node-20",
      "name": "Schedule: Every 15 Min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 780]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/?select=count",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}" }
          ]
        },
        "options": {
          "timeout": 10000,
          "response": { "response": { "neverError": true } }
        }
      },
      "id": "g-node-21",
      "name": "Ping Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 720]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://graph.facebook.com/{{ $env.WHATSAPP_API_VERSION }}/{{ $env.META_PHONE_NUMBER_ID }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{ $env.META_WHATSAPP_ACCESS_TOKEN }}" }
          ]
        },
        "options": {
          "timeout": 10000,
          "response": { "response": { "neverError": true } }
        }
      },
      "id": "g-node-22",
      "name": "Ping WhatsApp API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 860]
    },
    {
      "parameters": {
        "jsCode": "const supabaseResult = $('Ping Supabase').first().json;\nconst whatsappResult = $('Ping WhatsApp API').first().json;\n\nconst supabaseOk = !supabaseResult.error && (supabaseResult.statusCode === undefined || supabaseResult.statusCode < 400);\nconst whatsappOk = !whatsappResult.error && whatsappResult.id;\n\nconst failures = [];\nif (!supabaseOk) failures.push('Supabase');\nif (!whatsappOk) failures.push('WhatsApp API');\n\nreturn [{\n  json: {\n    all_healthy: failures.length === 0,\n    failures,\n    supabase_ok: supabaseOk,\n    whatsapp_ok: whatsappOk,\n    checked_at: new Date().toISOString()\n  }\n}];"
      },
      "id": "g-node-23",
      "name": "Evaluate Health",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 780]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond-unhealthy",
              "leftValue": "={{ $json.all_healthy }}",
              "rightValue": false,
              "operator": { "type": "boolean", "operation": "false" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "g-node-24",
      "name": "Any Failures?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [940, 780]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/{{ $env.WHATSAPP_API_VERSION }}/{{ $env.META_PHONE_NUMBER_ID }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{ $env.META_WHATSAPP_ACCESS_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $env.STAFF_NOTIFICATION_WHATSAPP }}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": \"🏥 *HEALTH CHECK FAILED*\\n\\nThe following services are DOWN:\\n{{ $json.failures.join(', ') }}\\n\\nChecked at: {{ $json.checked_at }}\\n\\nPlease investigate immediately.\"\n  }\n}",
        "options": { "timeout": 15000 }
      },
      "id": "g-node-25",
      "name": "Alert: Service Down",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 720]
    },
