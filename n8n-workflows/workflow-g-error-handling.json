        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $env.STAFF_NOTIFICATION_WHATSAPP }}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": \"🚨 *CRITICAL ERROR*\\n\\nWorkflow: {{ $('Parse & Sanitize Error').item.json.workflow_name }}\\nNode: {{ $('Parse & Sanitize Error').item.json.failed_node }}\\nError: {{ $('Parse & Sanitize Error').item.json.error_message }}\\nExecution: {{ $('Parse & Sanitize Error').item.json.execution_id }}\\nTime: {{ $('Parse & Sanitize Error').item.json.timestamp }}\\n\\nImmediate attention required!\"\n  }\n}",
        "options": { "timeout": 15000 }
      },
