        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"entity_type\": \"workflow_error\",\n  \"entity_id\": \"00000000-0000-0000-0000-000000000000\",\n  \"action\": \"critical_error\",\n  \"changes\": {\n    \"workflow\": \"{{ $('Parse & Sanitize Error').item.json.workflow_name }}\",\n    \"node\": \"{{ $('Parse & Sanitize Error').item.json.failed_node }}\",\n    \"error\": \"{{ $('Parse & Sanitize Error').item.json.error_message }}\",\n    \"execution_id\": \"{{ $('Parse & Sanitize Error').item.json.execution_id }}\",\n    \"context\": \"{{ $('Parse & Sanitize Error').item.json.context_sanitized }}\"\n  }\n}",
        "options": {}
      },
      "id": "g-node-14",
